<?xml version="1.0" encoding="UTF-8"?>
<!-- TIME-OF-DAY: HH:MM is simulation clock time (minutes from midnight). startHour/startMinute in SimulationConfig set the clock start (default 08:00). -->
<!--
  UC3 Shopping Mall B (open) — TWO food courts. Agents Agent_0 .. Agent_9.
  Pair with layoutVariant=MallB and serviceStationCapacity=2.

  Food court map setup (each court) — use AAgentSuperStation:
    FoodCourt  — tag FoodCourt, Stations = FoodCounter + FoodTable (prefer ≤3 each type)
    FoodCourt2 — tag FoodCourt2, same pattern
  StationIdentifier / actor tag must be FoodCounter or FoodTable.
  MoveTo uses area=; UseStation stages use superStation=.

  Bootstrap: even Agent_* → Entrance1, odd → Entrance2.
  Agent_0 opens Entrance2 early (Interact EntranceButton2) so odd agents are not
  stranded outside a Null-cut gate with no sidewalk detour.

  Optional thin entrance-only demo: Schedules/InfrastructurePlanningSchedule_MallB_EntranceRouteDemo.xml
  (set scheduleFile explicitly — AutoSelect uses THIS file for MallB).
-->
<schedule>

    <!-- Agent_0: open Entrance2, then ShopA → FoodCourt → Exit1 -->
    <agent id="Agent_0">
        <rule time="08:02"><then action="Idle" duration="2" /></rule>
        <rule time="08:04"><then action="MoveTo" area="EntranceButton2" /></rule>
        <rule time="08:08"><then action="Interact" target="EntranceButton2"/></rule>
        <rule time="08:12"><then action="MoveTo" area="ShopA" /></rule>
        <rule time="08:22"><then action="UseStation" area="ShopA" stationType="ShopA_Desk" duration="10" /></rule>
        <rule time="08:36"><then action="MoveTo" area="FoodCourt" /></rule>
        <rule time="08:46">
            <then action="UseStation">
                <stage superStation="FoodCourt" stationType="FoodCounter" duration="10"/>
                <stage superStation="FoodCourt" stationType="FoodTable" duration="14"/>
            </then>
        </rule>
        <rule time="09:16"><then action="MoveTo" area="Exit1" /></rule>
    </agent>

    <agent id="Agent_1">
        <rule time="08:04"><then action="Idle" duration="6" /></rule>
        <rule time="08:14"><then action="MoveTo" area="ShopB" /></rule>
        <rule time="08:24"><then action="UseStation" area="ShopB" stationType="ShopB_Desk" duration="10" /></rule>
        <rule time="08:38"><then action="MoveTo" area="FoodCourt2" /></rule>
        <rule time="08:48">
            <then action="UseStation">
                <stage superStation="FoodCourt2" stationType="FoodCounter" duration="10"/>
                <stage superStation="FoodCourt2" stationType="FoodTable" duration="14"/>
            </then>
        </rule>
        <rule time="09:18"><then action="MoveTo" area="Exit1" /></rule>
    </agent>

    <agent id="Agent_2">
        <rule time="08:03"><then action="Idle" duration="10" /></rule>
        <rule time="08:15"><then action="MoveTo" area="ShopA" /></rule>
        <rule time="08:28"><then action="MoveTo" area="ShopB" /></rule>
        <rule time="08:40"><then action="MoveTo" area="FoodCourt" /></rule>
        <rule time="08:52">
            <then action="UseStation">
                <stage superStation="FoodCourt" stationType="FoodCounter" duration="10"/>
                <stage superStation="FoodCourt" stationType="FoodTable" duration="14"/>
