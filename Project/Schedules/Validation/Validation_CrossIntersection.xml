<?xml version="1.0" encoding="UTF-8"?>
<!-- V07 Cross-intersection: Group 1 NW->SE (Agent_0-9), Group 2 WNW->ESE (Agent_10-19). -->
<!-- Paths intersect at map center. Two superGroups share rules across each cohort. -->

<schedule>

    <superGroup id="NW_to_SE">
        <members>
            <agent ref="Agent_0"/>
            <agent ref="Agent_1"/>
            <agent ref="Agent_2"/>
            <agent ref="Agent_3"/>
            <agent ref="Agent_4"/>
            <agent ref="Agent_5"/>
            <agent ref="Agent_6"/>
            <agent ref="Agent_7"/>
            <agent ref="Agent_8"/>
            <agent ref="Agent_9"/>
        </members>
        <rule time="00:00"><then action="Idle" duration="3"/></rule>
        <rule time="00:04"><then action="MoveTo" area="Exit_SE"/></rule>
    </superGroup>

    <superGroup id="WNW_to_ESE">
        <members>
            <agent ref="Agent_10"/>
            <agent ref="Agent_11"/>
            <agent ref="Agent_12"/>
            <agent ref="Agent_13"/>
            <agent ref="Agent_14"/>
            <agent ref="Agent_15"/>
            <agent ref="Agent_16"/>
            <agent ref="Agent_17"/>
            <agent ref="Agent_18"/>
            <agent ref="Agent_19"/>
        </members>
        <rule time="00:00"><then action="Idle" duration="2"/></rule>
        <rule time="00:04"><then action="MoveTo" area="Exit_ESE"/></rule>
    </superGroup>

</schedule>
